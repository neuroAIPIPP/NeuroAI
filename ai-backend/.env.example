# ============================================================
# NeuroAI Backend - Environment Variables
# ============================================================
# Copy file ini menjadi .env dan isi dengan values yang sesuai.

# Google Gemini API Key (untuk AI Insights)
# Dapatkan gratis di: https://aistudio.google.com/apikey
# 1. Buka https://aistudio.google.com/apikey
# 2. Login dengan Google Account
# 3. Klik "Create API Key"
# 4. Copy key dan paste di bawah ini
GEMINI_API_KEY=your_gemini_api_key_here
